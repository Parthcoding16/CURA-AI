# Copy this file to .env and fill in the values.
# These are SERVER-ONLY variables. Never prefix them with VITE_, or Vite will
# put them in the public JavaScript bundle.

# Required: Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: Upstash Redis, used for caching and rate limiting
# (https://console.upstash.com → your database → REST API).
# Leave blank to run without caching or rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
